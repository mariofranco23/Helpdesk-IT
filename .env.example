# === Base de Datos ===
DATABASE_URL=postgresql://helpdesk:helpdesk_password@localhost:5432/helpdesk_db

# === Seguridad ===
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HELPDESK_MFA_ENCRYPTION_KEY=tu-clave-fernet-base64-aqui

# Clave secreta para signing (generar con secrets.token_urlsafe(32))
SECRET_KEY=tu-secret-key-aqui

# === Configuración de la Aplicación ===
DEBUG=true
API_PORT=8000
FRONTEND_URL=http://localhost:3000

# === CORS ===
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# === Canales (Opcional en Etapa 1) ===
# Email
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SUPPORT_EMAIL=soporte@helpdesk.local

# WhatsApp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER=

# === Timezone ===
# Para SLA y reportes
TIMEZONE=America/Argentina/Cordoba
